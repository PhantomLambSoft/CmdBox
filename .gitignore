# ======================================
# Python artifacts
# ======================================

__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution and packaging
build/
dist/
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/
.wheels/
*.whl

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Virtual environments
venv/
.venv/
env/
.env/

# Poetry specific
.poetry/

# Pyenv
.python-version

# ======================================
# Testing and coverage
# ======================================

.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.pytest_cache/
.cache/

# Mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# ======================================
# IDE and editor folders
# ======================================

# JetBrains
.idea/
*.iml

# VS Code
.vscode/

# Sublime
*.sublime-project
*.sublime-workspace

# General editor swap files
*~
*.swp
*.swo
*.tmp

# ======================================
# OS generated files
# ======================================

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# ======================================
# Local application data
# ======================================

# If CmdBox stores JSON data locally in the user's environment rather than the repo,
# ignore any accidentally committed local data files:

*.local.json
data/
storage/
cmdbox_data/
cb_data/

# Avoid ignoring the actual storage module
!src/cmdbox/storage/
!src/cmdbox/storage/**

# ======================================
# Logs
# ======================================

*.log
logs/

# ======================================
# Miscellaneous
# ======================================

# Temporary files
tmp/
temp/

# Python REPL history
.python_history
